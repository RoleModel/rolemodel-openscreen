node_modules/
# Without this, a *symlink* named node_modules is not ignored — `node_modules/`
# matches directories only. A worktree pointed at the main checkout's deps got
# committed as a 120000 entry, and checking it out replaced the real directory
# with a link to itself: ELOOP on every pnpm command, in both checkouts.
node_modules
dist/
*.tgz
*.zip
.DS_Store
.env
.env.*
supabase/.temp/

# Working files from real recordings — never commit client footage or captures
*.openscreen
*.mp4
*.gif
*.m4a
*.wav
recordings/

# CodeGraph index — machine-local, rebuilt with `codegraph index`
.codegraph/
.claude/skills/impeccable/
HANDOFF.md

# Affinity's lock file, written while a document is open. The .af source beside it
# is worth keeping; a lock naming this machine is not.
*.af~lock~
