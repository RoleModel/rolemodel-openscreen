{
  "name": "rolemodel-openscreen",
  "version": "0.1.45",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "description": "RoleModel brand layer for OpenScreen — presets, wallpapers, annotation builders, and an agent skill.",
  "bin": {
    "rm-align-audio": "./bin/rm-align-audio.mjs",
    "rm-render-alignment": "./bin/rm-render-alignment.mjs",
    "rm-reconcile": "./bin/rm-reconcile.mjs",
    "rm-render-hyperframes": "./bin/rm-render-hyperframes.mjs",
    "rm-compose": "./bin/rm-compose.mjs",
    "rm-demo": "./bin/rm-demo.mjs",
    "rm-fal": "./bin/rm-fal.mjs",
    "rm-insert": "./bin/rm-insert.mjs",
    "rm-library": "./bin/rm-library.mjs",
    "rm-mux": "./bin/rm-mux.mjs",
    "rm-setup": "./bin/rm-setup.mjs",
    "rm-share": "./bin/rm-share.mjs",
    "rm-studio": "./bin/rm-studio.mjs",
    "rm-transcribe": "./bin/rm-transcribe.mjs",
    "rm-visual-beats": "./bin/rm-visual-beats.mjs",
    "rm-video": "./bin/rm-video.mjs",
    "rm-voice": "./bin/rm-voice.mjs"
  },
  "scripts": {
    "build": "pnpm run sync-brand && pnpm run optics && pnpm run optics-tokens && pnpm run figma-tokens && pnpm run icons && pnpm run imagery && pnpm run wallpapers",
    "prepare": "node scripts/install-git-hooks.mjs",
    "precommit": "node scripts/pre-commit.mjs",
    "check": "pnpm run sync-brand:check && pnpm run optics:check && pnpm run optics-tokens:check && pnpm run figma-tokens:check && pnpm run icons:check && pnpm run imagery:check && pnpm run bem:check && pnpm run verify && pnpm run sync-tap:check && pnpm run sync-docs:check",
    "dev": "node --watch-path=./bin --watch-path=./lib --watch bin/rm-studio.mjs --watch",
    "studio": "node bin/rm-studio.mjs",
    "presets": "node bin/rm-video.mjs presets",
    "wallpapers": "node lib/make-wallpapers.mjs",
    "wallpapers:reset": "node lib/make-wallpapers.mjs --reset",
    "verify": "node lib/verify.mjs",
    "sync-brand": "node lib/sync-brand.mjs",
    "sync-brand:check": "node lib/sync-brand.mjs --check",
    "optics": "node lib/optics-css.mjs",
    "optics:check": "node lib/optics-css.mjs --check",
    "scene": "node components/render-scene.mjs components/scene.html -o scene.mp4",
    "voice": "node bin/rm-voice.mjs",
    "voice:setup": "node bin/rm-voice.mjs --setup",
    "demo": "node bin/rm-demo.mjs",
    "sync-tap": "node lib/sync-tap.mjs",
    "sync-tap:check": "node lib/sync-tap.mjs --check",
    "forks": "node lib/forks.mjs",
    "forks:check": "node lib/forks.mjs --check",
    "icon": "node lib/make-icon.mjs",
    "sync-docs": "node lib/sync-docs.mjs",
    "sync-docs:check": "node lib/sync-docs.mjs --check",
    "optics-tokens": "node lib/optics-tokens.mjs",
    "optics-tokens:check": "node lib/optics-tokens.mjs --check",
    "figma-tokens": "node lib/figma-tokens.mjs",
    "figma-tokens:check": "node lib/figma-tokens.mjs --check",
    "icons": "node lib/make-icons.mjs",
    "icons:check": "node lib/make-icons.mjs --check",
    "logos": "node lib/make-logos.mjs",
    "imagery": "node lib/make-imagery.mjs",
    "vendor": "cp node_modules/gsap/dist/gsap.min.js brand/vendor/gsap.min.js && cp node_modules/wavesurfer.js/dist/wavesurfer.min.js brand/vendor/wavesurfer.min.js",
    "imagery:check": "node lib/make-imagery.mjs --check",
    "logos:check": "node lib/make-logos.mjs --check",
    "motion": "node lib/make-motion.mjs",
    "motion:check": "node lib/make-motion.mjs --check",
    "app": "node lib/launch-app.mjs",
    "bem": "node lib/bem-check.mjs",
    "bem:check": "node lib/bem-check.mjs --check",
    "check:ci": "pnpm run sync-brand:check && pnpm run optics:check && pnpm run optics-tokens:check && pnpm run figma-tokens:check && pnpm run icons:check && pnpm run imagery:check && pnpm run bem:check && pnpm run verify"
  },
  "devDependencies": {
    "@rolemodel/optics": "2.4.0",
    "gsap": "^3.14.2",
    "supabase": "^2.116.0",
    "wavesurfer.js": "^7.12.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rolemodel/rolemodel-openscreen.git"
  },
  "license": "MIT",
  "files": [
    "assets",
    "bin",
    "lib",
    "presets",
    "brand",
    "components",
    "skill",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "playwright": "^1.62.1",
    "playwright-recast": "^0.19.2"
  }
}
