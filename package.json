{
  "name": "rolemodel-openscreen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RoleModel brand layer for OpenScreen \u2014 presets, wallpapers, annotation builders, and an agent skill.",
  "bin": {
    "rm-demo": "./bin/rm-demo.mjs",
    "rm-library": "./bin/rm-library.mjs",
    "rm-mux": "./bin/rm-mux.mjs",
    "rm-setup": "./bin/rm-setup.mjs",
    "rm-share": "./bin/rm-share.mjs",
    "rm-studio": "./bin/rm-studio.mjs",
    "rm-video": "./bin/rm-video.mjs",
    "rm-voice": "./bin/rm-voice.mjs"
  },
  "scripts": {
    "build": "npm run sync-brand && npm run optics && npm run wallpapers",
    "check": "npm run sync-brand:check && npm run optics:check && npm run optics-tokens:check && npm run icons:check && npm run verify && npm run sync-tap:check && npm run sync-docs:check",
    "dev": "node --watch-path=./bin --watch-path=./lib --watch bin/rm-studio.mjs --watch",
    "studio": "node bin/rm-studio.mjs",
    "presets": "node bin/rm-video.mjs presets",
    "wallpapers": "node lib/make-wallpapers.mjs",
    "wallpapers:reset": "node lib/make-wallpapers.mjs --reset",
    "verify": "node lib/verify.mjs",
    "sync-brand": "node lib/sync-brand.mjs",
    "sync-brand:check": "node lib/sync-brand.mjs --check",
    "optics": "node lib/optics-css.mjs",
    "optics:check": "node lib/optics-css.mjs --check",
    "scene": "node components/render-scene.mjs components/scene.html -o scene.mp4",
    "voice": "node bin/rm-voice.mjs",
    "voice:setup": "node bin/rm-voice.mjs --setup",
    "demo": "node bin/rm-demo.mjs",
    "sync-tap": "node lib/sync-tap.mjs",
    "sync-tap:check": "node lib/sync-tap.mjs --check",
    "forks": "node lib/forks.mjs",
    "forks:check": "node lib/forks.mjs --check",
    "icon": "node lib/make-icon.mjs",
    "sync-docs": "node lib/sync-docs.mjs",
    "sync-docs:check": "node lib/sync-docs.mjs --check",
    "optics-tokens": "node lib/optics-tokens.mjs",
    "optics-tokens:check": "node lib/optics-tokens.mjs --check",
    "icons": "node lib/make-icons.mjs",
    "icons:check": "node lib/make-icons.mjs --check",
    "logos": "node lib/make-logos.mjs",
    "logos:check": "node lib/make-logos.mjs --check",
    "motion": "node lib/make-motion.mjs",
    "motion:check": "node lib/make-motion.mjs --check",
    "app": "node lib/launch-app.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rolemodel/rolemodel-openscreen.git"
  },
  "license": "MIT",
  "files": [
    "bin",
    "lib",
    "presets",
    "brand",
    "components",
    "skill",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright-recast": "^0.19.2"
  }
}
